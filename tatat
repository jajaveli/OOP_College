using System;

struct Product
{
    public string Id { get; set; }
    public string Name { get; set; }
    public string Description { get; set; }
    public int  Quantity { get; set; }
    public double Price { get; set; }
    public override string ToString()
    {
        return $"ID:{Id},Name: {Name}, Description: {Description}, Quantity: {Quantity}, Price: {Price}";
    }
    interface IWareHouse
    {
        List<Product> Products { get; set; }
        void Add(Product product) {  Products.Add(product); }

        void Remove(Product updated) {  Products.Remove(updated); }

        Product? Find(int id)
        {
            var product = Product.Find(product => p.Id == id);
            return product.Id == 0 ? null : product;
        }
    }
}
